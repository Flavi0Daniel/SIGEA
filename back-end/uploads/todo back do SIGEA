const AuthService = require('../services/AuthService');

class AuthController {
    // POST /api/auth/register
    async register(req, res) {
        try {
            const result = await AuthService.register(req.body);
            
            res.status(201).json({
                success: true,
                message: 'Usuário registado com sucesso',
                data: result
            });
